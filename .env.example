# Environment Configuration for CoopConnect AI
APP_ENV=development
SECRET_KEY=change-this-in-production-super-secret-key-32-chars
JWT_SECRET_KEY=change-this-in-production-jwt-secret-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Use SQLite for local test/dev or PostgreSQL for production/docker
DATABASE_URL=sqlite:///./coopconnect.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/coopconnect_db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173

# AWS Services Configuration (Optional for cloud deployment)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET=coopconnect-ai-media-assets

# Email & Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@coopconnect.ai
SMTP_PASSWORD=app-specific-password

# Cache & Celery Redis URL
REDIS_URL=redis://localhost:6379/0

# Logging Level
LOG_LEVEL=INFO
